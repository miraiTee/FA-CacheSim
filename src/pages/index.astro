---
import '../index.css';
import '../components/simulation/CacheComponents.css';

import Configs from '../components/Configs.jsx';
import CenterElems from '../components/mainpanel/CenterElems.jsx';
import RightElems from '../components/mainpanel/RightElems.jsx';
import CacheContainer from '../components/simulation/CacheContainer.jsx';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FA Cache Simulator</title>
  </head>

  <body>
    <div class="simulation-layout">
      <!-- 1. Main Simulation Area (LRU / MRU Cache Containers) -->
      <main class="simulation-area">
        <div class="cache-containers-wrapper">
          <CacheContainer policy="LRU" client:load />
          <CacheContainer policy="MRU" client:load />
        </div>
      </main>

      <!-- 2. Bottombar (Configs | CenterElems | RightElems) -->
      <aside class="config-bottombar">
        <Configs client:load />
        <CenterElems client:load />
        <RightElems client:load />
      </aside>
    </div>
  </body>
</html>