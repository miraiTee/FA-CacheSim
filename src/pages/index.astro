---
import '../index.css';
import Configs from '../components/Configs.jsx';
import MainPanel from '../components/mainpanel/MainPanel.jsx';
import SequencePanel from '../components/mainpanel/SequencePanel.jsx';
import TracePanel from '../components/mainpanel/TraceLog.jsx';
import Player from '../components/mainpanel/Player.jsx';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FA Cache Simulator</title>
  </head>
  <body>
    <div class="simulation-layout">
      <!-- Sidebar for System Configurations -->
      <aside class="config-sidebar">
        <Configs client:load />
      </aside>

      <!-- Main Area: Houses MainPanel, SequencePanel, Player, and TracePanel -->
      <main class="simulation-area">
        <MainPanel client:load />
        <SequencePanel client:load />
        <Player client:load />
        <TracePanel client:load />
      </main>
    </div>
  </body>
</html>